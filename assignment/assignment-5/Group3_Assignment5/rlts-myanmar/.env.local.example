# RLTS-MM backend mode
# "local"    -> zero-config demo mode: state lives in localStorage + BroadcastChannel,
#               so Admin/Trader/Driver tabs opened in the same browser sync instantly
#               with no server, no signup, and no risk of a flaky connection during
#               the live demo. This is the default and needs nothing else set below.
# "supabase" -> real cloud backend. Fill in the two keys below and run supabase/schema.sql
#               against your project first.
NEXT_PUBLIC_BACKEND_MODE=local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
