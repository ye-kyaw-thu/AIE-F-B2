FROM --platform=linux/amd64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libblas-dev \
    ca-certificates \
    cmake \
    git \
    libboost-all-dev \
    libgoogle-perftools-dev \
    libicu-dev \
    libsqlite3-dev \
    liblapack-dev \
    libopenblas-dev \
    libssl-dev \
    libyaml-cpp-dev \
    pkg-config \
    python3 \
    python3-pip \
    wget \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone --depth 1 https://github.com/marian-nmt/marian-dev.git marian-dev
WORKDIR /opt/marian-dev
RUN mkdir build && cd build && \
    cmake .. \
      -DCOMPILE_CPU=on \
      -DCOMPILE_CUDA=off \
      -DUSE_MKL=off \
      -DBLAS_LIBRARIES=/usr/lib/x86_64-linux-gnu/libopenblas.so \
      -DUSE_SENTENCEPIECE=on \
      -DUSE_NCCL=off \
      -DCMAKE_BUILD_TYPE=Release && \
    cmake --build . --parallel 2

ENV PATH="/opt/marian-dev/build:${PATH}"
WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
