[
  {"id": "1", "text": "မြန်မာ့ သမိုင်း မှာ စောက်ရှက် မ ရှိ ဆုံး အယုတ်မာဆုံး ကို ပြ ပါ ဆို ရင် ဒီလို လူမျိုး တွေ ကို ပြ ရ မှာ ပဲ", "polarization": "1", "political": "1", "racial": "1", "religious": "0", "gender": "0", "other": "0", "stereotype": "0", "vilification": "1", "dehumanization": "0", "extreme_language": "1", "lack_of_empathy": "0", "invalidation": "0"},
  {"id": "2", "text": "စစ်တပ် က သတ် တာ ပြည်သူ တွေ မှ မ ဟုတ် တာ အကြမ်းဖက် တွေ လေ အဲ့ဒီ မသာ တွေ က", "polarization": "1", "political": "1", "racial": "0", "religious": "0", "gender": "0", "other": "1", "stereotype": "0", "vilification": "0", "dehumanization": "0", "extreme_language": "1", "lack_of_empathy": "0", "invalidation": "0"},
  {"id": "3", "text": "ကလေး ကို ကြည့် တာ နဲ့ အမေ ဖြစ် သူ ဘယ်လို စရိုက် လဲ သိ တယ်", "polarization": "1", "political": "0", "racial": "0", "religious": "0", "gender": "1", "other": "0", "stereotype": "1", "vilification": "0", "dehumanization": "0", "extreme_language": "0", "lack_of_empathy": "0", "invalidation": "0"},
  {"id": "4", "text": "စောက်ရူး တွေ အုပ်ချုပ် နေ သရွေ့ မ ကောင်း တဲ့ ဘက် သွား နေ မှာ ပါ", "polarization": "1", "political": "1", "racial": "0", "religious": "0", "gender": "1", "other": "0", "stereotype": "0", "vilification": "1", "dehumanization": "0", "extreme_language": "1", "lack_of_empathy": "0", "invalidation": "0"},
  {"id": "5", "text": "အခြောက်မလင် ခွေးသူတောင်းစား", "polarization": "1", "political": "0", "racial": "0", "religious": "0", "gender": "1", "other": "1", "stereotype": "0", "vilification": "1", "dehumanization": "1", "extreme_language": "1", "lack_of_empathy": "1", "invalidation": "0"},
  {"id": "6", "text": "မ နိုင် တာ သိ လို့ ဘုရင် စနစ် နဲ့ ကိုင် ပြီး ချုပ် နေ တာ", "polarization": "1", "political": "1", "racial": "0", "religious": "0", "gender": "0", "other": "0", "stereotype": "0", "vilification": "0", "dehumanization": "0", "extreme_language": "0", "lack_of_empathy": "0", "invalidation": "1"},
  {"id": "7", "text": "ငါ သာ ဆို အဆဲ တွေ ပဲ တန်း နေ အောင် ထွက် မှာ", "polarization": "1", "political": "0", "racial": "0", "religious": "0", "gender": "0", "other": "1", "stereotype": "0", "vilification": "0", "dehumanization": "0", "extreme_language": "1", "lack_of_empathy": "1", "invalidation": "0"},
  {"id": "8", "text": "သူများ ကို မ ပြင် ခင် ကိုယ့် ဟာ ကို လည်း အရင် ပြင် ကြ ဦး", "polarization": "0", "political": "0", "racial": "0", "religious": "0", "gender": "0", "other": "0", "stereotype": "0", "vilification": "0", "dehumanization": "0", "extreme_language": "0", "lack_of_empathy": "0", "invalidation": "0"},
  {"id": "9", "text": "ဘယ်လို အယူ လဲ နော် တစ်မျိုးကြီး သူ တို့ နိုင်ငံ ဗုဒ္ဓ ဘာသာ မ ဟုတ် ဘူး ပေါ့ နက် ကိုးကွယ် ကြ တဲ့ လူမျိုး", "polarization": "1", "political": "0", "racial": "1", "religious": "1", "gender": "0", "other": "0", "stereotype": "1", "vilification": "0", "dehumanization": "0", "extreme_language": "0", "lack_of_empathy": "1", "invalidation": "0"},
  {"id": "10", "text": "မြန်မာ့ ယဉ်ကျေး မှု ဖျက် တဲ့ လူစား တွေ အခြား နည်း နဲ့ ပိုက်ဆံ ရှာ ပါ လား", "polarization": "1", "political": "0", "racial": "1", "religious": "0", "gender": "0", "other": "1", "stereotype": "0", "vilification": "1", "dehumanization": "0", "extreme_language": "0", "lack_of_empathy": "0", "invalidation": "0"}
