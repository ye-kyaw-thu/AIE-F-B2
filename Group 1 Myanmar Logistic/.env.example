# Required for Phase 2 login. Never overwrite an existing .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local origin. In Vercel Production set https://myanmarlogistics.vercel.app
# Used for signup email redirects; also allow /auth/callback in Supabase Auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Never put an elevated Supabase secret/service-role key in NEXT_PUBLIC_*.
# Demo provisioning will use a separate server-only setup process in Phase 2.

# Optional, setup CLI only: create a personal access token in Supabase account settings.
# Used by npm run setup:supabase to apply migrations and provision demo users.
# Never add this token to Vercel or NEXT_PUBLIC_*; remove/revoke after setup if desired.
SUPABASE_ACCESS_TOKEN=

# Runtime only, server-side: required for Admin Driver invitation emails.
# Supabase Settings → API Keys → secret key (or legacy service_role key).
# Add to .env.local and Vercel. Never use a NEXT_PUBLIC_* name for this value.
SUPABASE_SECRET_KEY=
