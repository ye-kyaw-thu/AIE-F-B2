{
  "name": "myanmar-trading-logistics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "verify": "npm run check && npm run test:db && npm run test:auth && npm run build",
    "test:auth": "node --experimental-strip-types --test tests/signup.test.mjs tests/language.test.mjs tests/driver-validation.test.mjs tests/email-callback.test.mjs tests/driver-delivery.test.mjs",
    "test:db": "node --test tests/database.test.mjs tests/trader-workflow.test.mjs tests/admin-workflow.test.mjs tests/driver-workflow.test.mjs tests/tracking.test.mjs tests/alerts-workflow.test.mjs tests/offline-queue.test.mjs tests/driver-onboarding.test.mjs",
    "test:live": "node scripts/test-live.mjs",
    "db:types": "node scripts/generate-local-types.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "db:migrate": "node scripts/migrate-supabase.mjs",
    "test:trader:live": "node scripts/test-trader-live.mjs",
    "test:admin:live": "node scripts/test-admin-live.mjs",
    "test:driver:live": "node scripts/test-driver-live.mjs",
    "test:realtime:live": "node scripts/test-realtime-live.mjs",
    "test:alerts:live": "node scripts/test-alerts-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
